# ══════════════════════════════════════════════════════════════════
# Workforce Intelligence v12.0 — Environment Variables
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your actual values
# 3. NEVER commit .env to version control
# ══════════════════════════════════════════════════════════════════

# ── DATABASE (must match docker-compose.yml) ──────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=wfi_user
DB_PASSWORD=P123/
DB_NAME=workforce_intelligence
DB_ROOT_PASSWORD=P123/

# ── SERVER ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── JWT AUTHENTICATION ────────────────────────────────────────────
# REQUIRED: 64+ random chars
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_to_a_64_character_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────
# Set to your frontend URL in production
CORS_ORIGIN=*

# ── SMTP EMAIL ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=
PASSWORD_RESET_ORIGIN=


# ── FILE UPLOADS ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── REDIS ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ── AI COPILOT (RAG) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ── RATE LIMITING ─────────────────────────────────────────────────
RATE_LIMIT_API=300
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5

# ── COMPANY ───────────────────────────────────────────────────────
COMPANY_NAME=Workforce Intelligence
COMPANY_DOMAIN=wfintelligence.internal
SESSION_TIMEOUT_HOURS=8

# ── DEFAULT CREDENTIALS (change before going live) ────────────────
# Admin:    admin@wfintelligence.com   / P123/
# HR:       hr@wfintelligence.com      / P123/
# Manager:  manager@wfintelligence.com / P123/
# Employee: employee@wfintelligence.com / P123/
DEMO_MODE=true
