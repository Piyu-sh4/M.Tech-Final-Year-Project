# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=workforce_intelligence

# ── JWT Auth ───────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random string before deploying!
JWT_SECRET=WIP@JWT#YourSuperSecretKeyHere_Change_Before_Deploy_2025!

# ── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────────────
# Set to your domain in production, e.g. https://yourcompany.com
# Leave as * for local development (file:// access)
CORS_ORIGIN=*

# ── AI Chat (Claude API) ────────────────────────────────────────
# Get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
