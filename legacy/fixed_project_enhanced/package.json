{
  "name": "workforce-intelligence-platform",
  "version": "6.0.0",
  "description": "AI-Powered HR, Payroll, Attendance & Task Management Platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "db:setup": "mysql -u root -p -e \"CREATE DATABASE IF NOT EXISTS workforce_intelligence;\"",
    "db:schema": "mysql -u root -p workforce_intelligence < database/schema.sql",
    "db:migrate51": "mysql -u root -p workforce_intelligence < database/migrate_v5.1.sql",
    "db:migrate60": "mysql -u root -p workforce_intelligence < database/migrate_v6.0.sql",
    "db:seed": "mysql -u root -p workforce_intelligence < database/seed_all_employees.sql",
    "db:seed:piyush": "mysql -u root -p workforce_intelligence < database/seed_piyush_sharma.sql",
    "db:init": "npm run db:setup && npm run db:schema && npm run db:migrate51 && npm run db:migrate60 && npm run db:seed",
    "db:complete": "mysql -u root -p < database/workforce_intelligence_COMPLETE.sql",
    "db:reset": "mysql -u root -p -e \"DROP DATABASE IF EXISTS workforce_intelligence;\" && npm run db:complete",
    "test": "jest --config=tests/jest.config.js",
    "test:watch": "jest --config=tests/jest.config.js --watch",
    "test:cov": "jest --config=tests/jest.config.js --coverage",
    "attrition": "python attrition_model.py",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "hrms",
    "payroll",
    "attendance",
    "task-management",
    "nodejs",
    "express",
    "mysql",
    "claude-ai"
  ],
  "author": "Workforce Intelligence Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "mysql": "^2.18.1",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5",
    "socket.io": "^4.7.5",
    "redis": "^4.7.0",
    "puppeteer": "^23.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}