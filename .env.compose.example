# Optional Compose overrides. Save them in an ignored .env file.
# Host port. Compose binds it to the local loopback address.
WFI_PORT=5500

# Set JWT_SECRET to a random value (openssl rand -hex 48) to keep
# login sessions valid after recreating the API container.
# JWT_SECRET=

# Set a private random access code before publishing through a tunnel.
# DEMO_ACCESS_CODE=

# Optional: set before first startup. Keep these values with the volume.
# DB_PASSWORD=
# DB_ROOT_PASSWORD=

# Optional. Without a key, the AI chat shows that the provider is unconfigured.
# ANTHROPIC_API_KEY=

# Set DEMO_MODE=false with a separately provisioned, non-demo database.
# The bundled Compose snapshot contains demo accounts even when seeding is disabled.
# DEMO_MODE=true
# Comma-separated IP addresses of trusted direct proxy peers. Leave unset to ignore forwarded IP headers.
# TRUSTED_PROXY_IPS=
# JWT_EXPIRES_IN=8h
# Set only when an approved frontend is hosted on a different origin.
# CORS_ORIGIN=

# Login attempts per IP and per normalized account, and registrations per IP.
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_LOGIN_ACCOUNT=15
# RATE_LIMIT_REGISTER=5

# Optional comma-separated application origins for passkeys on a custom port or host.
# APP_ORIGINS=https://workforce.bharatmedha.com,http://localhost:5500
